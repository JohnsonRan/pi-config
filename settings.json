{
  "lastChangelogVersion": "0.84.3",
  "theme": "dark",
  "packages": [
    "npm:context-mode",
    "git:github.com/xz-dev/pi-continuity",
    "npm:pi-powerline-footer",
    "git:github.com/xz-dev/human-handoff-skill",
    "git:github.com/xz-dev/SuperAgents-skill",
    "git:github.com/xz-dev/i-read-the-code-skill",
    "npm:browser-goblin",
    "git:github.com/xz-dev/pi-hermes-memory",
    "git:github.com/xz-dev/pi-continue-watchdog",
    "git:github.com/xz-dev/conventional-commits-skill",
    "git:github.com/xz-dev/pi-retry",
    "git:github.com/xz-dev/pi-notify",
    "git:github.com/xz-dev/pi-double-confirm-interrupt",
    "git:github.com/jonjonrankin/pi-caveman",
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/nicobailon/pi-intercom",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-cache-optimizer",
    "git:github.com/ayghri/i-have-adhd",
    "npm:pi-subagents",
    "git:github.com/JohnsonRan/pi-btw",
    "git:github.com/JohnsonRan/pi-telegram-operator",
    "git:github.com/JohnsonRan/pi-cliproxyapi-provider",
    "git:github.com/xz-dev/pi-reflect-watchdog"
  ],
  "defaultProvider": "cliproxyapi",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "enableInstallTelemetry": false,
  "powerline": {
    "preset": "nerd",
    "welcome": false,
    "layout": {
      "left": [
        "model",
        "thinking",
        "path",
        "git"
      ],
      "right": [
        "context_pct",
        "token_total",
        "cost",
        "time_spent"
      ],
      "secondary": [
        "shell_mode",
        "subagents",
        "extension_statuses"
      ]
    },
    "path": {
      "mode": "basename"
    },
    "git": {
      "showBranch": true,
      "showStaged": true,
      "showUnstaged": true,
      "showUntracked": true,
      "polling": "full"
    }
  },
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "cliproxyapi/gemini-3.7-flash-high",
        "thinking": "high",
        "fallbackModels": [
          "cliproxyapi/gemini-3.7-flash-high:high"
        ]
      },
      "delegate": {
        "model": "cliproxyapi/gpt-5.6-luna",
        "thinking": "xhigh",
        "fallbackModels": [
          "cliproxyapi/gemini-3.7-flash-high:high"
        ]
      }
    }
  }
}
