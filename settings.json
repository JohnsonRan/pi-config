{
  "lastChangelogVersion": "0.84.0",
  "theme": "dark",
  "packages": [
    "npm:pi-simplify",
    "npm:context-mode",
    "git:github.com/xz-dev/pi-continuity",
    "npm:pi-powerline-footer",
    "git:github.com/xz-dev/human-handoff-skill",
    "git:github.com/xz-dev/SuperAgents-skill",
    "git:github.com/xz-dev/i-read-the-code-skill",
    "npm:browser-goblin",
    "git:github.com/xz-dev/pi-tasks",
    "git:github.com/xz-dev/pi-hermes-memory",
    "git:github.com/xz-dev/pi-continue-watchdog",
    "git:github.com/xz-dev/conventional-commits-skill",
    "git:github.com/xz-dev/pi-subagents",
    "git:github.com/xz-dev/pi-retry",
    "git:github.com/xz-dev/pi-notify"
  ],
  "defaultProvider": "third-party",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "enableInstallTelemetry": false,
  "powerline": {
    "preset": "nerd",
    "layout": {
      "left": [
        "model",
        "thinking",
        "path",
        "git"
      ],
      "right": [
        "context_pct",
        "token_total",
        "cost",
        "time_spent"
      ],
      "secondary": [
        "shell_mode",
        "subagents",
        "extension_statuses"
      ]
    },
    "path": {
      "mode": "basename"
    },
    "git": {
      "showBranch": true,
      "showStaged": true,
      "showUnstaged": true,
      "showUntracked": true,
      "polling": "full"
    }
  },
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "third-party/gpt-5.6-luna",
        "thinking": "xhigh",
        "fallbackModels": [
          "third-party/deepseek-v4-flash:max"
        ]
      },
      "delegate": {
        "model": "third-party/gpt-5.6-luna",
        "thinking": "xhigh",
        "fallbackModels": [
          "third-party/deepseek-v4-flash:max"
        ]
      }
    }
  }
}